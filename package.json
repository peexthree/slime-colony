{
  "name": "lumivore-the-living-fractal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:assets": "node scripts/check-asset-refs.mjs",
    "ci": "npm run lint && npm run check:i18n && npm run check:assets && npm test && npm run build"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@webgpu/types": "^0.1.44",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
